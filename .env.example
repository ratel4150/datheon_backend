# Copiar a .env y llenar los valores

# Groq — gratis en console.groq.com
GROQ_API_KEY=gsk_...

# OpenAI — solo para embeddings, ~$1/mes de uso
OPENAI_API_KEY=sk-...

# Neon PostgreSQL — gratis en neon.tech
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://...

# Key compartida con Next.js para autenticar requests internos
INTERNAL_API_KEY=generar_un_string_aleatorio_seguro

# "development" o "production"
ENVIRONMENT=development

# Origins permitidos (Next.js)
# En producción: https://datheon.com,https://www.datheon.com
ALLOWED_ORIGINS=http://localhost:3000
